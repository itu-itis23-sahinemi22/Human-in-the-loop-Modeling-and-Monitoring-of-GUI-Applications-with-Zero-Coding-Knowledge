{
  "manifest_version": 3,
  "name": "Graph Recorder (Bitirme Demo)",
  "version": "0.1.0",
  "key": "",
  "description": "Web sitesinde gezerken, kullanıcının işaretlediği durumlardan yönlü bir graph (node + edge) çıkarır.",

  "permissions": ["sidePanel", "storage", "unlimitedStorage", "webNavigation", "debugger", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["settings.js", "fingerprint.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },

  "action": {
    "default_title": "Graph Recorder panelini aç"
  }
}
